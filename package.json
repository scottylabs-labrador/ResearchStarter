{
  "name": "researchstarter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/web",
    "apps/api"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @researchstarter/web",
    "build": "npm run build --workspace @researchstarter/web",
    "lint": "npm run lint --workspace @researchstarter/web",
    "preview": "npm run preview --workspace @researchstarter/web",
    "test_server": "npm run test_server --workspace @researchstarter/web",
    "storybook": "npm run storybook --workspace @researchstarter/web",
